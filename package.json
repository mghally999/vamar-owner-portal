{
  "name": "vamar-owner-portal",
  "private": true,
  "version": "0.0.0",
  "description": "Vamar Real Estate owner portal: owner mobile app, staff dashboard and API",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tooling/dev/start.mjs",
    "infra:up": "node tooling/dev/start.mjs db firebase",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @vamar/db generate",
    "db:migrate": "pnpm --filter @vamar/db migrate",
    "db:seed": "pnpm --filter @vamar/db seed",
    "db:reset": "pnpm --filter @vamar/db reset",
    "db:studio": "pnpm --filter @vamar/db studio",
    "dev:docker": "docker compose up -d --wait && turbo run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "type": "module"
}
