{
  "name": "@vamar/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure business rules shared by API, dashboard and app: zod schemas, money and date utils, cheque state machine, shares, occupancy, alerts, i18n keys",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
