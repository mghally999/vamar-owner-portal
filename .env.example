# Copy to .env for local development. Deployed environments use wrangler secrets instead.
DATABASE_URL=postgres://vamar:vamar@localhost:5432/vamar
DATABASE_URL_TEST=postgres://vamar:vamar@localhost:5432/vamar_test
# Runtime role used by the API locally (INSERT/SELECT only on audit_log)
DATABASE_URL_APP=postgres://vamar_app:vamar_app@localhost:5432/vamar
FIREBASE_PROJECT_ID=demo-vamar
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
