{
  "name": "@vamar/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vamar staff dashboard (React + Vite SPA served by the API Worker)",
  "scripts": {
    "dev": "pnpm --filter @vamar/tokens build && vite --port 5173",
    "build": "pnpm --filter @vamar/tokens build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.21",
    "@vamar/shared": "workspace:*",
    "@vamar/tokens": "workspace:*",
    "firebase": "^12.19.0",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
