{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vamar-owner-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The built dashboard is served from the same Worker: `/` = dashboard, `/api/*` = API.
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/privacy",
      "/healthz",
      "/readyz",
      "/download",
      "/download/*",
      "/app",
      "/app/*",
    ],
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vamar-files" }],
  // One cron: daily alerts at 08:00 Dubai (04:00 UTC).
  "triggers": { "crons": ["0 4 * * *"] },
  "vars": {
    "FIREBASE_PROJECT_ID": "vamar-owner-portal-c55c2",
    // Comma-separated ISO country codes whose phone numbers may sign in as owners.
    "ALLOWED_PHONE_COUNTRIES": "AE",
    "APP_LATEST_VERSION": "1.0.0",
    "APP_MIN_VERSION": "1.0.0",
    // The deployed Worker is production; the dev server (apps/api/src/dev-server.ts) sets its own
    // bindings and the test harness uses "test". index.ts refuses to serve when secrets are missing.
    "APP_ENV": "production",
  },
  "dev": { "port": 8787 },
  // Staging: same code, its own Worker, Neon branch and bucket; deployed from main by CI.
  // No cron (the account allows five; run the daily jobs with POST /api/staff/jobs/daily).
  "env": {
    "staging": {
      "name": "vamar-owner-portal-staging",
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "vamar-files-staging" }],
      "triggers": { "crons": [] },
      "vars": {
        "FIREBASE_PROJECT_ID": "vamar-owner-portal-c55c2",
        "ALLOWED_PHONE_COUNTRIES": "AE",
        "APP_LATEST_VERSION": "1.0.0",
        "APP_MIN_VERSION": "1.0.0",
        "APP_ENV": "staging",
      },
    },
  },
  // Secrets (set with `wrangler secret put`, locally in .dev.vars): DATABASE_URL, JWT_SECRET,
  // TOTP_ENC_KEY, EXPO_ACCESS_TOKEN, FIREBASE_AUTH_EMULATOR_HOST (dev only)
}
