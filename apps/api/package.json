{
  "name": "@vamar/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono API on Cloudflare Workers; also serves the built dashboard as static assets",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "echo 'worker is bundled by wrangler at deploy time'",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "dev:wrangler": "wrangler dev --port 8787",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@vamar/db": "workspace:*",
    "@vamar/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^1.19.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
